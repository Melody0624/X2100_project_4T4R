menuconfig CONFIG_DFS_YAFFS
    bool "支持yaffs文件系统(支持烧录)"
    default n
    select CONFIG_OS_POSIX
    help
        "支持烧录需要烧录工具以及pc端镜像制作工具"


config CONFIG_DFS_YAFFS_MOUNT_PARTITION0
    bool "yaffs文件系统 挂载分区0"
    default n
    help
        "查询是否有同名设备注册,如果已经注册则自动挂载为yaffs格式"

config CONFIG_DFS_YAFFS_MOUNT_PARTITION0_NAME
    string "挂载分区0名称"
    default "partition0"
    depends on CONFIG_DFS_YAFFS_MOUNT_PARTITION0




