array CONFIG_X2600_LCD_ROTATOR_ANGLE_LIST
    int "rotator 旋转角度"
    item "旋转0°" 0
    item "旋转90°" 90
    item "旋转180°" 180
    item "旋转270°" 270


menuconfig CONFIG_X2600_LCD
    bool "LCD 驱动"
    select CONFIG_FB
    select CONFIG_X2600_DPU_HAL

choice "选择数据通路(MIXER/ROTATOR/SRDMA/LAYER)"
    default CONFIG_X2600_LCD_LAYER_CHANNEL
config CONFIG_X2600_LCD_MIXER_CHANNEL
    bool "mixer(多fb叠加到内存+srdma)输出"
    select CONFIG_X2600_LCD_USE_MIXER
config CONFIG_X2600_LCD_ROTATOR_CHANNEL
    bool "rotator(多fb叠加到内存+rotator)输出"
    select CONFIG_X2600_LCD_USE_ROTATOR
config CONFIG_X2600_LCD_SRDMA_CHANNEL
    bool "srdma(单fb无叠加)输出"
    select CONFIG_X2600_LCD_USE_SRDMA
config CONFIG_X2600_LCD_LAYER_CHANNEL
    bool "layer(多fb叠加直通lcd)输出"
    select CONFIG_X2600_LCD_USE_LAYER
endchoice

config CONFIG_X2600_LCD_CONFIG_BY_RTOS
    bool "linux 启动后接管 rtos 内的fb配置及内存"
    select CONFIG_MEMORY_INHERIT
    default n
    help
        使用该功能, 须在uboot添加SHARE_MEM_MB/SHARE_MEM_KB, RTOS初始化fb将直接在uboot的预留内存申请, Linux启动后使用fb则直接接管这块内存

config CONFIG_X2600_LCD_PAN_DISPLAY_SYNC
    bool "pan display 时等待帧同步完成(帧缓冲数为一帧时推荐开启)"
    default y

config MD_X2600_510_FB_LIMIT_DMA_BURST_LEN
    bool "减少fb单次dma 搬运大小 (为了cpu 更容易抢占ddr)"
    default n

menu "mipi 屏幕相关配置"

config MD_X2600_510_FB_MIPI_CMD_WAITTIME_US
    int "mipi write_cmd 等待时长 (单位为us)(快启时根据屏特性自行设定)"
    default 1000

menuconfig MD_X2600_FB_CFG_MIPI_SWAP
    bool "mipi lane_P/N pin 交换"
    default n

config MD_X2600_FB_MIPI_CLK_PIN
    bool "将 clk 的 p脚 和 n脚 功能互换"
    default n

config MD_X2600_FB_MIPI_LANE0_PIN
    bool "将 lane0 的 p脚 和 n脚 功能互换"
    default n

config MD_X2600_FB_MIPI_LANE1_PIN
    bool "将 lane1 的 p脚 和 n脚 功能互换"
    default n

config MD_X2600_FB_MIPI_LANE2_PIN
    bool "将 lane2 的 p脚 和 n脚 功能互换"
    default n

config MD_X2600_FB_MIPI_LANE3_PIN
    bool "将 lane3 的 p脚 和 n脚 功能互换"
    default n

endmenu

endmenu

config CONFIG_X2600_LCD_USE_MIXER
    bool
    select CONFIG_X2600_LCD_USE_LAYER
    select CONFIG_X2600_LCD_USE_SRDMA
    select CONFIG_X2600_FB_LAYER_MIXER

config CONFIG_X2600_LCD_USE_ROTATOR
    bool
    select CONFIG_X2600_LCD_USE_LAYER
    select CONFIG_X2600_LCD_ROTATOR_CONFIG
    select CONFIG_X2600_FB_LAYER_MIXER

config CONFIG_X2600_LCD_USE_SRDMA
    bool
    select CONFIG_X2600_LCD_SRDMA_CONFIG

config CONFIG_X2600_LCD_USE_LAYER
    bool
    select CONFIG_X2600_LCD_FB_LAYER_CONFIG

menuconfig CONFIG_X2600_LCD_ROTATOR_CONFIG
    bool "旋转"
    depends on CONFIG_X2600_LCD_USE_ROTATOR

config CONFIG_X2600_LCD_ROTATOR_ANGLE
    int "旋转角度"
    default 90
    choice from CONFIG_X2600_LCD_ROTATOR_ANGLE_LIST

config CONFIG_X2600_LCD_ROTATOR_FRAMES
    int "旋转帧缓冲数"
    default 2

endmenu

menuconfig CONFIG_X2600_LCD_SRDMA_CONFIG
    bool "srdma配置"
    depends on CONFIG_X2600_LCD_USE_SRDMA

config CONFIG_X2600_LCD_SRDMA_FRAMES
    int "srdma 的帧缓冲数(或mixer模式下叠加后输出的帧缓冲数)"
    default 2

config CONFIG_X2600_LCD_SRDMA_NAME
    string "设备节点名字"
    default "fb_srdma"

endmenu

menuconfig CONFIG_X2600_LCD_FB_LAYER_CONFIG
    bool "MIXER/ROTATOR/LAYER 共用配置部分(多层fb叠加)"
    depends on CONFIG_X2600_LCD_USE_LAYER

config CONFIG_X2600_LCD_USE_DEFAULT_ORDER
    bool "强制使用默认的层级配置（fb0为最底层，fb3为最顶层,应用配置无效）"

config CONFIG_X2600_LCD_FB0_ENABLE
    bool "使能fb0"
    default n

config CONFIG_X2600_LCD_FB0_FRM_CNT
    int "fb0 的帧缓冲数"
    default 2

config CONFIG_X2600_LCD_FB0_ALPHA
    int "fb0 的透明度(0-255)"
    default 255

config CONFIG_X2600_LCD_FB0_NAME
    string "设备节点名字"
    default "fb0"

config CONFIG_X2600_LCD_FB1_ENABLE
    bool "使能fb1"
    default n

config CONFIG_X2600_LCD_FB1_FRM_CNT
    int "fb1 的帧缓冲数"
    default 2

config CONFIG_X2600_LCD_FB1_ALPHA
    int "fb1 的透明度(0-255)"
    default 255

config CONFIG_X2600_LCD_FB1_NAME
    string "设备节点名字"
    default "fb1"

config CONFIG_X2600_LCD_FB2_ENABLE
    bool "使能fb2"
    default n

config CONFIG_X2600_LCD_FB2_FRM_CNT
    int "fb2 的帧缓冲数"
    default 2

config CONFIG_X2600_LCD_FB2_ALPHA
    int "fb2 的透明度(0-255)"
    default 255

config CONFIG_X2600_LCD_FB2_NAME
    string "设备节点名字"
    default "fb2"

config CONFIG_X2600_LCD_FB3_ENABLE
    bool "使能fb3"
    default n

config CONFIG_X2600_LCD_FB3_FRM_CNT
    int "fb3 的帧缓冲数"
    default 2

config CONFIG_X2600_LCD_FB3_ALPHA
    int "fb3 的透明度(0-255)"
    default 255

config CONFIG_X2600_LCD_FB3_NAME
    string "设备节点名字"
    default "fb3"

menuconfig CONFIG_X2600_LCD_FB_ENABLE_USER_CONFIG
    bool "自定义fb的尺寸"
    default n

menuconfig CONFIG_X2600_LCD_FB0_USER_ENABLE
    bool "  使能fb0自定义"
    default n

config CONFIG_X2600_LCD_FB0_USER_WIDTH
    int "fb0的宽"
    default -1

config CONFIG_X2600_LCD_FB0_USER_HEIGHT
    int "fb0的高"
    default -1

config CONFIG_X2600_LCD_FB0_USER_XPOS
    int "fb0在lcd上水平方向的偏移"
