menu "MMC 总线"

config CONFIG_SOC_AD100_MSC0_BUS
    bool "选择 MMC0"
    select CONFIG_MMC

choice "          选择MMC0 GPIO"
    default CONFIG_SOC_AD100_MSC0_PD_4BIT
    depends on CONFIG_SOC_AD100_MSC0_BUS

config CONFIG_SOC_AD100_MSC0_PD_4BIT
    bool "    MMC0 Bus 4bit (PD00 ~ PD05)"

config CONFIG_SOC_AD100_MSC0_PD_1BIT
    bool "    MMC0 Bus 1bit (PD00 ~ PD02)"

endchoice

config CONFIG_SOC_AD100_MSC0_MAX_FREQ
    int "  MMC0最大速度"
    default 100000000
    depends on CONFIG_SOC_AD100_MSC0_BUS
    help
        "支持范围是 0 ~ 200M "



config CONFIG_SOC_AD100_MSC1_BUS
    bool "选择 MMC1"
    select CONFIG_MMC

choice "          选择MMC1/SDIO GPIO"
    default CONFIG_SOC_AD100_MSC1_PC_4BIT
    depends on CONFIG_SOC_AD100_MSC1_BUS

config CONFIG_SOC_AD100_MSC1_PC_4BIT
    bool "    MMC1/SDIO Bus 4bit (PC25 ~ PC30)"

config CONFIG_SOC_AD100_MSC1_PC_1BIT
    bool "    MMC1/SDIO Bus 1bit (PC25 ~ PC27)"

config CONFIG_SOC_AD100_MSC1_PD_4BIT
    bool "    MMC1/SDIO Bus 4bit (PD06 ~ PD11)"

config CONFIG_SOC_AD100_MSC1_PD_1BIT
    bool "    MMC1/SDIO Bus 1bit (PD06 ~ PD08)"

endchoice

config CONFIG_SOC_AD100_MSC1_MAX_FREQ
    int "  MMC1/SDIO最大速度"
    default 100000000
    depends on CONFIG_SOC_AD100_MSC1_BUS
    help
        "支持范围是 0 ~ 200M "

endmenu
