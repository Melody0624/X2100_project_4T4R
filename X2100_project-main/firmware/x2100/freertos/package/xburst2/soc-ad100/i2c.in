menu "I2C 总线"
    help
        "依赖于 I2C 驱动"

config CONFIG_AD100_I2C0_BUS
    bool "选择I2C0"
    select CONFIG_I2C

choice "              选择I2C0 GPIO"
    default CONFIG_AD100_I2C0_PC
    depends on CONFIG_AD100_I2C0_BUS

config CONFIG_AD100_I2C0_PC
    bool "SCL:GPIO_PC(0) SDA:GPIO_PC(1)"

config CONFIG_AD100_I2C0_PD
    bool "SCL:GPIO_PD(4) SDA:GPIO_PD(3)"

endchoice

config CONFIG_AD100_I2C0_RATE
    int "       I2C0 速度 "
    default 400000
    depends on CONFIG_AD100_I2C0_BUS



config CONFIG_AD100_I2C1_BUS
    bool "选择I2C1"
    select CONFIG_I2C

choice "              选择I2C1 GPIO"
    default CONFIG_AD100_I2C1_PB
    depends on CONFIG_AD100_I2C1_BUS

config CONFIG_AD100_I2C1_PB
    bool "SCL:GPIO_PB(0) SDA:GPIO_PB(1)"

config CONFIG_AD100_I2C1_PC
    bool "SCL:GPIO_PC(2) SDA:GPIO_PC(3)"

endchoice

config CONFIG_AD100_I2C1_RATE
    int "        I2C1 速度 "
    default 400000
    depends on CONFIG_AD100_I2C1_BUS


config CONFIG_AD100_I2C2_BUS
    bool "选择I2C2"
    select CONFIG_I2C

choice "              选择I2C2 GPIO"
    default CONFIG_AD100_I2C2_PB
    depends on CONFIG_AD100_I2C2_BUS

config CONFIG_AD100_I2C2_PB
    bool "SCL:GPIO_PB(3) SDA:GPIO_PB(2)"

config CONFIG_AD100_I2C2_PC
    bool "SCL:GPIO_PC(19) SDA:GPIO_PC(20)"

endchoice

config CONFIG_AD100_I2C2_RATE
    int "        I2C2 速度 "
    default 400000
    depends on CONFIG_AD100_I2C2_BUS


config CONFIG_AD100_I2C3_BUS
    bool "选择I2C3"
    select CONFIG_I2C

choice "              选择I2C3 GPIO"
    default CONFIG_AD100_I2C3_PE
    depends on CONFIG_AD100_I2C3_BUS

config CONFIG_AD100_I2C3_PC
    bool "SCL:GPIO_PC(21) SDA:GPIO_PC(22)"

config CONFIG_AD100_I2C3_PE
    bool "SCL:GPIO_PE(5) SDA:GPIO_PE(6)"

endchoice

config CONFIG_AD100_I2C3_RATE
    int "       I2C3 速度 "
    default 400000
    depends on CONFIG_AD100_I2C3_BUS

endmenu # I2C 总线