    bool "使能 conn vic0"

config CONFIG_X2000_CONN_VIC1
    bool "使能 conn vic1"

endmenu

config CONFIG_X2000_CONN_FB
    bool "为Linux端提供RTOS端的FB驱动(核间通信)"

menuconfig CONFIG_X2000_CONN_ISP
    bool "为Linux端提供RTOS端的ISP驱动(核间通信)"
    select CONFIG_X2000_CONN

config CONFIG_X2000_CONN_ISP0
    bool "使能 conn isp0"

config CONFIG_X2000_CONN_ISP1
    bool "使能 conn isp1"

endmenu


menuconfig CONFIG_X2000_CONN_BLK
    bool "为Linux端提供RTOS端的BLK(mmc)驱动(核间通信)"
    select CONFIG_X2000_CONN

config CONFIG_X2000_CONN_BLK_START_ADDR
    int "块设备起始地址(单位字节)"
    default 0x100000

config CONFIG_X2000_CONN_BLK_SIZE
    int "块设备大小"
    default 10485760

endmenu


menuconfig  CONFIG_X2000_CONN_PCM
    bool "为Linux端提供RTOS端的PCM驱动(核间通信)"
    select CONFIG_X2000_CONN

config CONFIG_X2000_CONN_PCM_PLAYBACK
    bool "使能 conn_pcm_playback"

endmenu


menuconfig CONFIG_X2000_CONN_FS
    bool "RTOS端的文件系统读/写相关操作通知到Linux端(核间通信)"
    select CONFIG_CONN_FS
    select CONFIG_X2000_CONN

endmenu

