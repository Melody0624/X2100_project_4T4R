menuconfig CONFIG_X2000_EFUSE
    bool "efuse (芯片熔丝内容)"
    select CONFIG_EFUSE
    select CONFIG_GPIO_PIN

config CONFIG_X2000_EFUSE_VDDQ
    string "EFUSE_VDDQ"
    choice from SOC_GPIO_PIN_LEVELS
    default -1,0

choice "选择读写efuse段的校验模式"
    default CONFIG_X2000_EFUSE_MODE_NONE
config CONFIG_X2000_EFUSE_MODE_HAMMING
    bool "使用海明码对原始数据进行编码"
    select CONFIG_EFUSE_MODE_HAMMING
config CONFIG_X2000_EFUSE_MODE_NONE
    bool "不使用编码校验功能，读写原始数据"
    select CONFIG_EFUSE_MODE_NONE
endchoice

endmenu # CONFIG_X2000_EFUSE

menuconfig CONFIG_X2000_PM
    bool "电源管理 (关机/休眠)"
    select CONFIG_PM

config CONFIG_X2000_PM_REDUCE_VOLTAGE
    string "休眠降低电压gpio与电平"
    choice from SOC_GPIO_PIN_LEVELS
    default -1,0

endmenu

config CONFIG_X2000_VPU_JPEG_ENCODE
    bool "vpu_jpeg_encode(硬件编码Legacy)"

menuconfig CONFIG_X2000_CONN
    bool "conn(核间通信)"
    select CONFIG_CONN
    select CONFIG_RING_MEM

config CONFIG_X2000_CONN_MAX_LINK_COUNT
    int "conn 可用的最大连接数"
    default 16

endmenu

menuconfig CONFIG_X2000_CONN_VIC
    bool "为Linux端提供RTOS端的VIC驱动(核间通信)"
