config CONFIG_X2000_AUDIO
    bool

source package/xburst2/soc-x2000/pcm.in

config CONFIG_X2000_DMIC
    bool "dmic(外接数字mic)"
    select CONFIG_PCM
    select CONFIG_X2000_AUDIO

config CONFIG_X2000_ADC
    bool "adc (电压采样)"
    select CONFIG_ADC

config CONFIG_X2000_AES
    bool "aes (编解码)"
    select CONFIG_AES

config CONFIG_X2000_PWM
    bool "pwm (脉宽调制)"
    select CONFIG_PWM

config CONFIG_X2000_WDT
    bool "watchdog(看门狗)"
    select CONFIG_WDT

config CONFIG_X2000_RTC
    bool "rtc (墙上时间)"
    select CONFIG_RTC

config CONFIG_X2000_DTRNG
    bool "dtrng 驱动(获取随机数功能)"
