menuconfig CONFING_GSL1680_TOUCH
    bool "gsl1680触摸屏"
    select CONFIG_INPUT

config CONFIG_GSL1680_DEV_NAME
    string "触摸屏设备名称"
    default "gsl1680"

config CONFIG_GSL1680_MAX_EVENT_COUNT
    int "触摸屏事件缓冲区大小"
    default 64

config CONFIG_GSL1680_SCREEN_X
    string "gsl1680触摸屏长"
    default 480

config CONFIG_GSL1680_SCREEN_Y
    string "gsl1680触摸屏宽"
    default 320

config CONFIG_GSL1680_GPIO_RESET
    string "gpio reset(gsl1680 复位脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_GSL1680_GPIO_INT
    string "gpio int(gsl1680 中断脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_GSL1680_I2C_BUSNUM
    int "i2c bus num (gsl1680 挂接的i2c总线号)"
    default -1

endmenu