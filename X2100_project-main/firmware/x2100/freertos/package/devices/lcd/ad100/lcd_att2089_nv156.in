menuconfig CONFIG_AD100_LVDS_ATT2089_NV156
    bool "TFT ATT2089_NV156 (1024*600) (AD100) (lvds接口转eDP)"
    select CONFIG_AD100_LCD
    select CONFIG_I2C
    depends on CONFIG_SOC_AD100

config CONFIG_AD100_ATT2089_I2C_BUSNUM
    int "i2c bus num (codec 挂接的i2c总线号)"
    default -1

config CONFIG_AD100_ATT2089_POWER_EN
    string "gpio power level (lcd power使能引脚及有效电平)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1
    help
        "如 GPIO_PB(20),0: 表示power使能脚为PB20,且为低电平有效 (具体power使能有效电平请查看硬件原理图)"

config CONFIG_AD100_ATT2089_RST
    string "gpio reset level (lcd 复位引脚及有效电平)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1
    help
        "如 GPIO_PB(17),0: 表示reset脚为PB17,且为低电平有效 (具体reset有效电平请查看屏IC手册)"

config CONFIG_AD100_ATT2089_BL
    string "gpio reset level (lcd 背光使能引脚及有效电平)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1
    help
        "如 GPIO_PB(16),0: 表示backlight脚为PB16,且为低电平有效 (具体reset有效电平请查看屏IC手册)"

config CONFIG_ATT2089_POWER_REGULATOR_NAME
    string "regulator name(通过名字获取 LCD module 电源管理器)"
    default "-1"

endmenu # MD_AD100_LCD_NV156