menuconfig CONFIG_AD100_SLCD_ST7789P3
    bool "SLCD ST7789P3 (240x320) (AD100)"
    select CONFIG_AD100_LCD
    depends on CONFIG_SOC_AD100

config CONFIG_AD100_ST7789P3_CS
    string "gpio chip select(lcd 片选引脚)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1,0

config CONFIG_AD100_ST7789P3_RD
    string "gpio lcd read signal(lcd 读引脚)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1,0

config CONFIG_AD100_ST7789P3_RST
    string "gpio reset(lcd 复位引脚)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1,0

config CONFIG_AD100_ST7789P3_POWER_EN
    string "gpio power enable(lcd power使能引脚)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1,0

endmenu # CONFIG_AD100_SLCD_ST7789P3
