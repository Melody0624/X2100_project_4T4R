menuconfig CONFIG_AD100_TFT_ST7701S_50H9005
    bool "TFT ST7701S_50H9005 (480*854) (AD100) (TFT 16bit 接口)"
    select CONFIG_AD100_LCD
    depends on CONFIG_SOC_AD100

array AD100_FB_FMT
    string "fb 格式"
    item "fb_fmt_RGB555" fb_fmt_RGB555
    item "fb_fmt_RGB565" fb_fmt_RGB565
    item "fb_fmt_RGB888" fb_fmt_RGB888
    item "fb_fmt_ARGB8888" fb_fmt_ARGB8888
    item "fb_fmt_NV12" fb_fmt_NV12
    item "fb_fmt_NV21" fb_fmt_NV21
    item "fb_fmt_yuv422" fb_fmt_yuv422

config CONFIG_AD100_ST7701S_50H9005_POWER_EN
    string "gpio power level (lcd power使能引脚及有效电平)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1
    help
        "如 GPIO_PB(20),0: 表示power使能脚为PB20,且为低电平有效 (具体power使能有效电平请查看硬件原理图)"

config CONFIG_AD100_ST7701S_50H9005_BACKLIGHT_EN
    string "gpio backlight level (lcd 背光使能引脚及有效电平)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1

config CONFIG_AD100_ST7701S_50H9005_CS
    string "gpio SPI CS level (lcd spi片选引脚及有效电平)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1

config CONFIG_AD100_ST7701S_50H9005_RST
    string "gpio reset level (lcd 复位引脚及有效电平)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1

config CONFIG_AD100_ST7701S_50H9005_SDA
    string "gpio SPI SDA level (lcd spi SDA引脚及有效电平)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1

config CONFIG_AD100_ST7701S_50H9005_SCL
    string "gpio SPI SCl level (lcd spi SCl引脚及有效电平)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1

config CONFIG_LCD_POWER_REGULATOR_NAME
    string "regulator name(通过名字获取 LCD module 电源管理器)"
    default "-1"

config CONFIG_AD100_ST7701S_50H9005_FB_FMT
    string "fb 格式选择"
    default fb_fmt_ARGB8888
    choice from AD100_FB_FMT

endmenu # CONFIG_AD100_TFT_ST7701S_50H9005