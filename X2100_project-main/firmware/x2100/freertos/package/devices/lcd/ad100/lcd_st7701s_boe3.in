menuconfig CONFIG_AD100_LCD_ST7701S_BOE3
    bool "TFT ST7701S_BOE3 (480x480) (AD100) (mipi接口)"
    select CONFIG_AD100_LCD
    select CONFIG_REGULATOR
    depends on CONFIG_SOC_AD100

array AD100_FB_FMT
    string "fb 格式"
    item "fb_fmt_RGB555" fb_fmt_RGB555
    item "fb_fmt_RGB565" fb_fmt_RGB565
    item "fb_fmt_RGB888" fb_fmt_RGB888
    item "fb_fmt_ARGB8888" fb_fmt_ARGB8888
    item "fb_fmt_NV12" fb_fmt_NV12
    item "fb_fmt_NV21" fb_fmt_NV21
    item "fb_fmt_yuv422" fb_fmt_yuv422

config CONFIG_AD100_ST7701S_BOE3_BACKLIGHT_EN
    string "gpio backlight enable(lcd backlight使能引脚及有效电平)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1

config CONFIG_AD100_ST7701S_BOE3_RST
    string "gpio reset(lcd 复位引脚及有效电平)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1

config CONFIG_AD100_ST7701S_BOE3_POWER_EN
    string "gpio power(lcd power使能引脚及有效电平)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1

config CONFIG_LCD_POWER_REGULATOR_NAME
    string "regulator name(通过名字获取 lcd module 电源管理器)"
    default "-1"

config CONFIG_AD100_ST7701S_BOE3_FB_FMT
    string "fb 格式选择"
    default fb_fmt_ARGB8888
    choice from AD100_FB_FMT

endmenu # CONFIG_AD100_LCD_ST7701S_BOE3