menuconfig CONFIG_X2000_TFT_ST7701
    bool "TFT ST7701 (480*800) (X2000) (TFT 16bit 接口)"
    select CONFIG_X2000_LCD
    depends on CONFIG_SOC_X2000

config CONFIG_X2000_ST7701_POWER_EN
    string "gpio power (lcd power使能引脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X2000_ST7701_BACKLIGHT_EN
    string "gpio backlight (lcd 背光使能引脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X2000_ST7701_CS
    string "gpio SPI CS (lcd spi片选引脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X2000_ST7701_RST
    string "gpio reset (lcd 复位引脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X2000_ST7701_SDA
    string "gpio SPI SDA (lcd spi SDA引脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X2000_ST7701_SCL
    string "gpio SPI SCl (lcd spi SCl引脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_LCD_POWER_REGULATOR_NAME
    string "regulator name(通过名字获取 LCD module 电源管理器)"
    default "-1"

endmenu # CONFIG_X2000_TFT_ST7701