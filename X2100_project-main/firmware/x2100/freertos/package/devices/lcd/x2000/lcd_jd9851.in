menuconfig CONFIG_X2000_SLCD_JD9851
    bool "SLCD JD9851 (240x320) (X2000)"
    select CONFIG_X2000_LCD
    depends on CONFIG_SOC_X2000

config CONFIG_X2000_JD9851_USE_TE
    bool "开启图像防裂屏功能 使用GPIO_PD(19)"
    default y

config CONFIG_X2000_JD9851_CS
    string "gpio chip select(lcd 片选引脚)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1,0

config CONFIG_X2000_JD9851_RD
    string "gpio lcd read signal(lcd 读引脚)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1,0

config CONFIG_X2000_JD9851_RST
    string "gpio reset level (lcd 复位引脚及有效电平)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1,0
    help
        "如 GPIO_PB(17),0: 表示reset脚为PB17,且为低电平有效 (具体reset有效电平请查看屏IC手册)"

config CONFIG_X2000_JD9851_POWER_EN
    string "gpio power level (lcd power使能引脚及有效电平)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1,0
    help
        "如 GPIO_PB(20),0: 表示power使能脚为PB20,且为低电平有效 (具体power使能有效电平请查看硬件原理图)"


endmenu # CONFIG_X2000_SLCD_JD9851
