menuconfig CONFIG_X2000_MIPI_OTM8018B
    bool "TFT OTM8018B (480*800) (X2000) (mipi接口)"
    select CONFIG_X2000_LCD
    depends on CONFIG_SOC_X2000

config CONFIG_X2000_OTM8018B_BACKLIGHT_EN
    string "gpio backlight enable(lcd backlight使能引脚)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1

config CONFIG_X2000_OTM8018B_RST
    string "gpio reset level (lcd 复位引脚及有效电平)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1
    help
        "如 GPIO_PB(17),0: 表示reset脚为PB17,且为低电平有效 (具体reset有效电平请查看屏IC手册)"

config CONFIG_X2000_OTM8018B_POWER_EN
    string "gpio power level (lcd power使能引脚及有效电平)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1
    help
        "如 GPIO_PB(20),0: 表示power使能脚为PB20,且为低电平有效 (具体power使能有效电平请查看硬件原理图)"

endmenu # MD_X2000_LCD_OTM8018B