menuconfig CONFIG_X1021_SLCD_KWH035
    bool "SLCD KWH035 (X1021)"
    select CONFIG_X1021_LCD
    depends on CONFIG_SOC_X1021

config CONFIG_X1021_KWH035_TE
    string "gpio tearing effect(lcd 图像防裂屏引脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1021_KWH035_CS
    string "gpio chip select(lcd 片选引脚)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1,0

config CONFIG_X1021_KWH035_RD
    string "gpio lcd read signal(lcd 读引脚)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1,0

config CONFIG_X1021_KWH035_RST
    string "gpio reset(lcd 复位引脚)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1,0

config CONFIG_X1021_KWH035_VDD_EN
    string "gpio vdd enable(lcd vdd使能引脚)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1,0

endmenu # CONFIG_X1021_SLCD_KWH035