menuconfig CONFIG_X1600_TFT_ST77903_8BIT
    bool "LCD ST77903 (320x480) (X1600) (tft 8bit接口)"
    select CONFIG_X1600_LCD
    depends on CONFIG_SOC_X1600

config CONFIG_X1600_ST77903_RST
    string "gpio reset(lcd 复位引脚)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1

config CONFIG_X1600_ST77903_SPI_CS
    string "gpio spi cs pin(片选脚)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1

config CONFIG_X1600_ST77903_SPI_SCL
    string "gpio spi clk(时钟引脚)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1

config CONFIG_X1600_ST77903_SPI_SDA
    string "gpio spi sda(mosi 输出引脚)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1

endmenu # CONFIG_X1600_TFT_ST77903_8BIT