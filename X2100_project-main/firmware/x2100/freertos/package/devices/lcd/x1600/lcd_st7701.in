menuconfig CONFIG_X1600_TFT_ST7701
    bool "TFT ST7701 (480x854) (X1600)"
    select CONFIG_X1600_LCD
    depends on CONFIG_SOC_X1600

config CONFIG_X1600_ST7701_RST
    string "gpio reset(lcd 复位引脚)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1,0

config CONFIG_X1600_ST7701_POWER_EN
    string "gpio power enable(lcd power使能引脚)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1,0

config CONFIG_X1600_ST7701_SPI_BUS_NUM
    int "spi bus num(挂接的spi总线号)"
    default -1

config CONFIG_X1600_ST7701_SPI_CS
    string "spi cs pin(spi 片选脚)"
    choice from SOC_GPIO_PINS
    default -1

endmenu # CONFIG_X1600_TFT_ST7701