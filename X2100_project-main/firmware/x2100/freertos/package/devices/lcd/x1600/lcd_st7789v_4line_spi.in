menuconfig CONFIG_X1600_SLCD_ST7789V_4LINE_SPI
    bool "SLCD ST7789V (240x320) (X1600) (4line_spi接口)"
    select CONFIG_X1600_LCD
    depends on CONFIG_SOC_X1600


config CONFIG_X1600_ST7789V_4LINE_SPI_CS
    string "gpio chip select(lcd 片选引脚)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1

config CONFIG_X1600_ST7789V_4LINE_SPI_RST
    string "gpio reset(lcd 复位引脚)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1

config CONFIG_X1600_ST7789V_4LINE_SPI_POWER_EN
    string "gpio power enable(lcd power使能引脚)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1

endmenu # CONFIG_X1600_SLCD_ST7789V_4LINE_SPI