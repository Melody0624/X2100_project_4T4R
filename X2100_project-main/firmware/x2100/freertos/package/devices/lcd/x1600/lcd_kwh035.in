menuconfig CONFIG_X1600_SLCD_KWH035
    bool "SLCD KWH035 (320x480) (X1600)"
    select CONFIG_X1600_LCD
    depends on CONFIG_SOC_X1600

config CONFIG_X1600_KWH035_USE_TE
    bool "开启图像防裂屏功能 使用GPIO_PA(27)"
    default y

config CONFIG_X1600_KWH035_CS
    string "gpio chip select(lcd 片选引脚)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1,0

config CONFIG_X1600_KWH035_RD
    string "gpio lcd read signal(lcd 读引脚)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1,0

config CONFIG_X1600_KWH035_RST
    string "gpio reset(lcd 复位引脚)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1,0

config CONFIG_X1600_KWH035_POWER_EN
    string "gpio power enable(lcd power使能引脚)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1,0

endmenu # CONFIG_X1600_SLCD_KWH035