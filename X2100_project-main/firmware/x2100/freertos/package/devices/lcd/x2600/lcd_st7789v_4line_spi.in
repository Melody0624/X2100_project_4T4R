menuconfig CONFIG_X2600_SLCD_ST7789V_4LINE_SPI
    bool "SLCD ST7789V (240*320) (X2600) (4line_spi接口)"
    select CONFIG_X2600_LCD
    depends on CONFIG_SOC_X2600

config CONFIG_X2600_ST7789V_4LINE_SPI_CS
    string "gpio chip select(lcd 片选引脚)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1

config CONFIG_X2600_ST7789V_4LINE_SPI_RST
    string "gpio reset(lcd 复位引脚)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1

config CONFIG_X2600_ST7789V_4LINE_SPI_POWER_EN
    string "gpio power level (lcd power使能引脚及有效电平)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1
    help
        "如 GPIO_PB(20),0: 表示power使能脚为PB20,且为低电平有效 (具体power使能有效电平请查看硬件原理图)"

endmenu # CONFIG_X2600_SLCD_ST7789V_4LINE_SPI