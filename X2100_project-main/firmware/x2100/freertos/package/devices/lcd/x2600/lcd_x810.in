menuconfig CONFIG_X2600_LVDS_X810
    bool "TFT X810 (800*480) (X2600) (lvds接口)"
    select CONFIG_X2600_LCD
    depends on CONFIG_SOC_X2600

config CONFIG_X2600_X810_POWER_EN
    string "gpio power level (lcd power使能引脚及有效电平)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1
    help
        "如 GPIO_PB(20),0: 表示power使能脚为PB20,且为低电平有效 (具体power使能有效电平请查看硬件原理图)"

config CONFIG_X2600_X810_DISP
    string "gpio disp level (lcd disp使能引脚及有效电平)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1
    help
        "模式控制:1为正常模式 0 为待机模式"

config CONFIG_X2600_X810_SELB
    string "gpio selb level (lcd selb使能引脚及有效电平)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1
    help
        "格式数据选择:1:8bits 0:6bits"

config CONFIG_X2600_X810_RST
    string "gpio rst level (lcd rst使能引脚及有效电平)"
    choice from SOC_GPIO_PIN_LEVELS
    default -1

config CONFIG_LCD_POWER_REGULATOR_NAME
    string "regulator name(通过名字获取 LCD module 电源管理器)"
    default "-1"

endmenu # MD_X2600_LCD_X810