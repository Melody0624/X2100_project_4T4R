menuconfig CONFIG_X1000_SENSOR_BF20A6
    bool "sensor bf20a6 (dvp,yuyv)"
    select CONFIG_I2C
    select CONFIG_X1000_CIM
    depends on CONFIG_SOC_X1000S

config CONFIG_X1000_BF20A6_GPIO_RESET
    string "gpio reset(sensor 复位脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1000_BF20A6_GPIO_PWDN
    string "gpio pwdn(sensor 电源控制引脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1000_BF20A6_GPIO_POWER_EN
    string "gpio power_en(sensor 模块电源控制引脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1000_BF20A6_I2C_BUSNUM
    int "i2c bus num (sensor 挂接的i2c总线号)"
    default -1

endmenu # CONFIG_X1000_SENSOR_BF20A6