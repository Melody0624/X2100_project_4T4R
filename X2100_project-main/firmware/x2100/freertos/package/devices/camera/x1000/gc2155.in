menuconfig CONFIG_X1000_SENSOR_GC2155
    bool "sensor gc2155 (dvp,yuyv)"
    select CONFIG_I2C
    select CONFIG_X1000_CIM
    depends on CONFIG_SOC_X1000

config CONFIG_X1000_GC2155_GPIO_RESET
    string "gpio reset(sensor 复位脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1000_GC2155_GPIO_PWDN
    string "gpio pwdn(sensor 电源控制引脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1000_GC2155_GPIO_POWER_EN
    string "gpio power_en(sensor 模块电源控制引脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1000_GC2155_I2C_BUSNUM
    int "i2c bus num (sensor 挂接的i2c总线号)"
    default -1

endmenu # CONFIG_X1000_SENSOR_GC2155
