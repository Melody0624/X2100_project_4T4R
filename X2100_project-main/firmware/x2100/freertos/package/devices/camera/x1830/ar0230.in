menuconfig CONFIG_X1830_SENSOR_AR0230
    bool "sensor ar0230 (dvp,raw12)"
    select CONFIG_I2C
    select CONFIG_X1830_VIC
    depends on CONFIG_SOC_X1830S

choice "        ar0230 dvp 分辨率选择"
    default CONFIG_AR0230_1920X1080
config CONFIG_AR0230_640X1072
    bool "640*1072"
config CONFIG_AR0230_1920X1080
    bool "1920*1080"
endchoice

config CONFIG_X1830_AR0230_GPIO_RESET
    string "gpio reset(sensor 复位脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1830_AR0230_GPIO_PWDN
    string "gpio pwdn(sensor 电源控制引脚, 低有效)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1830_AR0230_GPIO_POWER
    string "gpio power(sensor 电源控制引脚, 高有效)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1830_AR0230_GPIO_I2C_SEL
    string "gpio i2c select(sensor i2c 使能脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1830_AR0230_I2C_BUSNUM
    int "i2c bus num (sensor 挂接的i2c总线号)"
    default -1

endmenu # CONFIG_X1830_SENSOR_AR0230