menuconfig CONFIG_X1830_SENSOR_AR0522
    bool "sensor ar0522 (mipi,raw8)"
    select CONFIG_I2C
    select CONFIG_X1830_VIC
    depends on CONFIG_SOC_X1830S

config CONFIG_X1830_AR0522_GPIO_RESET
    string "gpio reset(sensor 复位脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1830_AR0522_GPIO_PWDN
    string "gpio pwdn(sensor 电源控制引脚, 低有效)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1830_AR0522_GPIO_POWER
    string "gpio power(sensor 电源控制引脚, 高有效)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1830_AR0522_GPIO_I2C_SEL
    string "gpio i2c select(sensor i2c 使能脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1830_AR0522_I2C_BUSNUM
    int "i2c bus num (sensor 挂接的i2c总线号)"
    default -1

endmenu # CONFIG_X1830_SENSOR_AR0522

