menuconfig CONFIG_X1600_SENSOR_STI2250_MIPI
    bool "sensor sti2250 (mipi raw8)"
    select CONFIG_I2C
    select CONFIG_X1600_CAMERA
    depends on CONFIG_SOC_X1600

config CONFIG_X1600_STI2250_GPIO_RESET
    string "gpio reset(sensor 复位脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1600_STI2250_GPIO_PWDN
    string "gpio pwdn(sensor 电源控制引脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1600_STI2250_I2C_BUSNUM
    int "i2c bus num (sensor 挂接的i2c总线号)"
    default -1

endmenu # CONFIG_X1600_SENSOR_STI2250_MIPI
