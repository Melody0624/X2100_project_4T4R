menuconfig CONFIG_X1600_SENSOR_SC031
    bool "sensor sc031 (dvp,mipi)"
    select CONFIG_I2C
    select CONFIG_X1600_CAMERA
    depends on CONFIG_SOC_X1600

config CONFIG_X1600_SC031_GPIO_RESET
    string "gpio reset(sensor 复位脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1600_SC031_GPIO_PWDN
    string "gpio pwdn(sensor 电源控制引脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1600_SC031_I2C_BUSNUM
    int "i2c bus num (sensor 挂接的i2c总线号)"
    default -1


choice "    选择接口类型"
    default CONFIG_X1600_SENSOR_SC031_DVP

config CONFIG_X1600_SENSOR_SC031_DVP
    bool "DVP,raw8"

config CONFIG_X1600_SENSOR_SC031_MIPI
    bool "MIPI, raw10"

endchoice

endmenu # CONFIG_X1600_SENSOR_SC031
