menuconfig CONFIG_X1600_SENSOR_SC035
    bool "sensor sc035 (dvp,mipi)"
    select CONFIG_I2C
    select CONFIG_X1600_CAMERA
    depends on CONFIG_SOC_X1600

config CONFIG_X1600_SC035_GPIO_POWER
    string "gpio power(sensor 电源控制引脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1600_SC035_GPIO_RESET
    string "gpio reset(sensor 复位脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1600_SC035_GPIO_PWDN
    string "gpio pwdn(sensor 电源控制引脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1600_SC035_I2C_BUSNUM
    int "i2c bus num (sensor 挂接的i2c总线号)"
    default -1


choice "    选择接口类型"
    default CONFIG_X1600_SENSOR_SC035_DVP

config CONFIG_X1600_SENSOR_SC035_DVP
    bool "DVP,raw8"

config CONFIG_X1600_SENSOR_SC035_MIPI
    bool "MIPI, raw8"

endchoice

endmenu # CONFIG_X1600_SENSOR_SC035
