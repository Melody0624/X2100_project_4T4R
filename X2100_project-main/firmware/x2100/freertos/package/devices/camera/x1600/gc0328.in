menuconfig CONFIG_X1600_SENSOR_GC0328
    bool "sensor gc0328 (dvp,yuyv)"
    select CONFIG_I2C
    select CONFIG_X1600_CAMERA
    depends on CONFIG_SOC_X1600

config CONFIG_X1600_GC0328_GPIO_POWER
    string "gpio power(sensor模块 供电引脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1600_GC0328_GPIO_RESET
    string "gpio reset(sensor 复位脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1600_GC0328_GPIO_PWDN
    string "gpio pwdn(sensor standby控制引脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1600_GC0328_I2C_BUSNUM
    int "i2c bus num (sensor 挂接的i2c总线号)"
    default -1

endmenu # CONFIG_X1600_SENSOR_GC0328
