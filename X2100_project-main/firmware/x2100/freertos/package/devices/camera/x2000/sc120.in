menuconfig CONFIG_X2000_SENSOR_SC120
    bool "sensor sc120 (mipi, yuv422)"
    select CONFIG_I2C
    select CONFIG_X2000_CAMERA
    depends on CONFIG_SOC_X2000

source package/xburst2/soc-x2000/camera/interface_type.in

config CONFIG_X2000_SC120_MIPI_INDEX
    string "选择索引号(sensor 连接soc控制器接口)"
    choice from CAMERA_INTERFACE_TYPE_SELECT
    default -1

config CONFIG_X2000_SC120_MIPI_GPIO_POWER
    string "gpio power(sensor 模块电源控制引脚)"
    choice from SOC_GPIO_PINS
    default -1


config CONFIG_X2000_SC120_MIPI_POWER_REGULATOR_NAME
    string "regulator name(通过名字获取 sensor module 电源管理器)"
    default "-1"

config CONFIG_X2000_SC120_MIPI_GPIO_PWDN
    string "gpio pwdn(sensor 电源控制引脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X2000_SC120_MIPI_GPIO_RESET
    string "gpio reset(sensor 复位脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X2000_SC120_MIPI_I2C_BUSNUM
    int "i2c bus num (sensor 挂接的i2c总线号)"
    default -1


endmenu # CONFIG_X2000_SENSOR_SC120
