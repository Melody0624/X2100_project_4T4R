menuconfig MD_X2000_OV2735_SENSOR_MIPI
    bool "sensor ov2735 (mipi,raw10)"
    select CONFIG_X2000_CAMERA
    depends on CONFIG_SOC_X2000

menuconfig CONFIG_X2000_SENSOR0_OV2735
    bool "sensor0 config"

config MD_X2000_SENSOR0_OV2735_NAME
    string "sensor module name"
    default "ov2735-vis0"

config MD_X2000_SENSOR0_OV2735_GPIO_RESET
    string "gpio reset(sensor 复位脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2000_SENSOR0_OV2735_GPIO_PWDN
    string "gpio pwdn(sensor 电源控制引脚, 低有效)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2000_SENSOR0_OV2735_GPIO_POWER
    string "gpio power(sensor 电源控制引脚, 高有效)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2000_SENSOR0_OV2735_REGULATOR_NAME
    string "regulator name(通过名字获取 sensor module 电源管理器)"
    default "-1"

config MD_X2000_SENSOR0_OV2735_I2C_BUSNUM
    int "i2c bus num (sensor 挂接的i2c总线号)"
    default -1

config MD_X2000_SENSOR0_OV2735_I2C_ADDR
    int "i2c device addr (sensor的i2c地址)"
    default -1

config MD_X2000_SENSOR0_OV2735_CAM_BUSNUM
    int "cam bus num (sensor 挂接的vic/cim总线号)"
    default -1

config CONFIG_X2000_SENSOR0_OV2735_ISP_BIN_SELECT
    bool "sensor isp bin select"
    default n
config CONFIG_X2000_SENSOR0_OV2735_ISP_BIN_PATH
    string "sensor isp bin path"
    default "devices/camera/x2000/ov2735/ov2735-halley5-vis0-x2000.bin"
    depends on CONFIG_X2000_SENSOR0_OV2735_ISP_BIN_SELECT

endmenu


menuconfig CONFIG_X2000_SENSOR1_OV2735
    bool "sensor1 config"

config MD_X2000_SENSOR1_OV2735_NAME
    string "sensor module name"
    default "ov2735-vis1"

config MD_X2000_SENSOR1_OV2735_GPIO_RESET
    string "gpio reset(sensor 复位脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2000_SENSOR1_OV2735_GPIO_PWDN
    string "gpio pwdn(sensor 电源控制引脚, 低有效)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2000_SENSOR1_OV2735_GPIO_POWER
    string "gpio power(sensor 电源控制引脚, 高有效)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2000_SENSOR1_OV2735_REGULATOR_NAME
    string "regulator name(通过名字获取 sensor module 电源管理器)"
    default "-1"

config MD_X2000_SENSOR1_OV2735_I2C_BUSNUM
    int "i2c bus num (sensor 挂接的i2c总线号)"
    default -1

config MD_X2000_SENSOR1_OV2735_I2C_ADDR
    int "i2c device addr (sensor的i2c地址)"
    default -1

config MD_X2000_SENSOR1_OV2735_CAM_BUSNUM
    int "cam bus num (sensor 挂接的vic/cim总线号)"
    default -1

config CONFIG_X2000_SENSOR1_OV2735_ISP_BIN_SELECT
    bool "sensor isp bin select"
    default n
config CONFIG_X2000_SENSOR1_OV2735_ISP_BIN_PATH
    string "sensor isp bin path"
    default "devices/camera/x2000/ov2735/ov2735-halley5-vis1-x2000.bin"
    depends on CONFIG_X2000_SENSOR1_OV2735_ISP_BIN_SELECT


endmenu

endmenu # MD_X2000_OV2735_SENSOR_MIPI