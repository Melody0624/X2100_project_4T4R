menuconfig CONFIG_X2000_SENSOR_SC2355_MIPI
    bool "sensor sc2355 (mipi,raw10)"
    select CONFIG_X2000_CAMERA
    depends on CONFIG_SOC_X2000

array SENSOR_SC2355_RESOLUTION
    string "sensor sc2355 resolution"
    item "1280*720 30fps" "SC2355_1280_720_30FPS"
    item "640*360 30fps binning" "SC2355_640_360_BINNING_30FPS"

menuconfig CONFIG_X2000_SENSOR0_SC2355
	bool "sensor0 config"

config CONFIG_X2000_SC2355_SENSOR0_NAME
    string "sensor module name"
    default "sc2355-ir0"

config CONFIG_X2000_SC2355_RESOLUTION0
    string "resolution0(sc2355分辨率配置)"
    choice from SENSOR_SC2355_RESOLUTION
    default "SC2355_1280_720_30FPS"

config CONFIG_X2000_SC2355_GPIO_RESET0
    string "gpio reset(sensor 复位脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X2000_SC2355_GPIO_PWDN0
    string "gpio pwdn(sensor 电源控制引脚, 低有效)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X2000_SC2355_GPIO_POWER0
    string "gpio power(sensor 电源控制引脚, 高有效)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X2000_SC2355_SENSOR0_REGULATOR_NAME
	string "regulator name(通过名字获取 sensor module 电源管理器)"
	default "GPIO-POWER0"

config CONFIG_X2000_SC2355_I2C_BUSNUM0
    int "i2c bus num (sensor 挂接的i2c总线号)"
    default -1

config CONFIG_X2000_SC2355_I2C_ADDR0
	int "i2c device addr (sensor的i2c地址)"
	default -1

config CONFIG_X2000_SC2355_VIC_BUSNUM0
	int "vic bus num (sensor 挂接的vic总线号)"
	default -1

config CONFIG_X2000_SC2355_STROBE
    string "sensor strobe gpio (sensor strobe gpio)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X2000_SC2355_LIGHT_CTL
    string "sensor light control gpio (sensor light control gpio)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X2000_SC2355_LED_DRIVER_I2C_BUSNUM
    int "led driver i2c bus num (led驱动芯片 挂接的i2c总线号)"
    default -1
endmenu


menuconfig CONFIG_X2000_SENSOR1_SC2355
	bool "sensor1 config"

config CONFIG_X2000_SC2355_SENSOR1_NAME
    string "sensor module name"
    default "sc2355-ir1"

config CONFIG_X2000_SC2355_RESOLUTION1
    string "resolution1(sc2355分辨率配置)"
    choice from SENSOR_SC2355_RESOLUTION
    default "SC2355_1280_720_30FPS"

config CONFIG_X2000_SC2355_GPIO_RESET1
    string "gpio reset(sensor 复位脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X2000_SC2355_GPIO_PWDN1
    string "gpio pwdn(sensor 电源控制引脚, 低有效)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X2000_SC2355_GPIO_POWER1
    string "gpio power(sensor 电源控制引脚, 高有效)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X2000_SC2355_SENSOR1_REGULATOR_NAME
	string "regulator name(通过名字获取 sensor module 电源管理器)"
	default "GPIO-POWER0"

config CONFIG_X2000_SC2355_I2C_BUSNUM1
    int "i2c bus num (sensor 挂接的i2c总线号)"
    default -1

config CONFIG_X2000_SC2355_I2C_ADDR1
	int "i2c device addr (sensor的i2c地址)"
	default -1

config CONFIG_X2000_SC2355_VIC_BUSNUM1
	int "vic bus num (sensor 挂接的vic总线号)"
	default -1

endmenu

endmenu
