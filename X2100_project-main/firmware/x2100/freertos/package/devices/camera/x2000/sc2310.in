menuconfig MD_X2000_SENSOR_SC2310_MIPI
    bool "sensor sc2310 (mipi,raw10)"
    select CONFIG_X2000_CAMERA
    depends on CONFIG_SOC_X2000

menuconfig CONFIG_X2000_SENSOR0_SC2310
	bool "sensor0 config"

config MD_X2000_SC2310_SENSOR0_NAME
    string "sensor module name"
    default "sc2310-ir"

config MD_X2000_SC2310_GPIO_RESET0
    string "gpio reset(sensor 复位脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2000_SC2310_GPIO_PWDN0
    string "gpio pwdn(sensor 电源控制引脚, 低有效)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2000_SC2310_GPIO_POWER0
    string "gpio power(sensor 电源控制引脚, 高有效)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2000_SC2310_SENSOR0_REGULATOR_NAME
	string "regulator name(通过名字获取 sensor module 电源管理器)"
	default "GPIO-POWER0"

config MD_X2000_SC2310_I2C_BUSNUM0
    int "i2c bus num (sensor 挂接的i2c总线号)"
    default -1

config MD_X2000_SC2310_I2C_ADDR0
	int "i2c device addr (sensor的i2c地址)"
	default -1

config MD_X2000_SC2310_VIC_BUSNUM0
	int "vic bus num (sensor 挂接的vic总线号)"
	default -1

config CONFIG_X2000_SENSOR0_SC2310_ISP_BIN_SELECT
    bool "sensor isp bin select"
    default n
config CONFIG_X2000_SENSOR0_SC2310_ISP_BIN_PATH
    string "sensor isp bin path"
    default "devices/camera/x2000/sc2310/sc2310-ir-x2000.bin"
    depends on CONFIG_X2000_SENSOR0_SC2310_ISP_BIN_SELECT

endmenu


menuconfig CONFIG_X2000_SENSOR1_SC2310
	bool "sensor1 config"

config MD_X2000_SC2310_SENSOR1_NAME
    string "sensor module name"
    default "sc2310-vis"

config MD_X2000_SC2310_GPIO_RESET1
    string "gpio reset(sensor 复位脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2000_SC2310_GPIO_PWDN1
    string "gpio pwdn(sensor 电源控制引脚, 低有效)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2000_SC2310_GPIO_POWER1
    string "gpio power(sensor 电源控制引脚, 高有效)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2000_SC2310_SENSOR1_REGULATOR_NAME
	string "regulator name(通过名字获取 sensor module 电源管理器)"
	default "GPIO-POWER0"

config MD_X2000_SC2310_I2C_BUSNUM1
    int "i2c bus num (sensor 挂接的i2c总线号)"
    default -1

config MD_X2000_SC2310_I2C_ADDR1
	int "i2c device addr (sensor的i2c地址)"
	default -1

config MD_X2000_SC2310_VIC_BUSNUM1
	int "vic bus num (sensor 挂接的vic总线号)"
	default -1

config CONFIG_X2000_SENSOR1_SC2310_ISP_BIN_SELECT
    bool "sensor isp bin select"
    default n
config CONFIG_X2000_SENSOR1_SC2310_ISP_BIN_PATH
    string "sensor isp bin path"
    default "devices/camera/x2000/sc2310/sc2310-vis-x2000.bin"
    depends on CONFIG_X2000_SENSOR1_SC2310_ISP_BIN_SELECT

endmenu

endmenu