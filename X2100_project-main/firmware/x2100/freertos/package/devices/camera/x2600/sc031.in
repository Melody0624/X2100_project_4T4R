menuconfig CONFIG_X2600_SENSOR_SC031
    bool "sensor sc031 (dvp)"
    select CONFIG_I2C
    select CONFIG_X2600_CAMERA
    depends on CONFIG_SOC_X2600

config CONFIG_X2600_SC031_GPIO_RESET
    string "gpio reset(sensor 复位脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X2600_SC031_GPIO_PWDN
    string "gpio pwdn(sensor 电源控制引脚, 低有效)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X2600_SC031_GPIO_POWER
    string "gpio power(sensor 电源控制引脚, 高有效)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X2600_SC031_I2C_BUSNUM
    int "i2c bus num (sensor 挂接的i2c总线号)"
    default -1

endmenu # CONFIG_X2600_SENSOR_SC031
