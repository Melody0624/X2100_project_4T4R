menuconfig CONFIG_X1520_SENSOR_GC2145
    bool "sensor gc2145 (dvp,yuyv)"
    select CONFIG_I2C
    select CONFIG_X1520_VIC
    depends on CONFIG_SOC_X1520

config CONFIG_X1520_GC2145_GPIO_RESET
    string "gpio reset(sensor 复位脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1520_GC2145_GPIO_PWDN
    string "gpio pwdn(sensor 电源控制引脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1520_GC2145_I2C_BUSNUM
    int "i2c bus num (sensor 挂接的i2c总线号)"
    default -1


choice "    选择格式"
    default CONFIG_X1520_SENSOR_GC2145_FMT_YUYV

config CONFIG_X1520_SENSOR_GC2145_FMT_YUYV
    bool "fmt yuyv"

config CONFIG_X1520_SENSOR_GC2145_FMT_NV12
    bool "fmt nv12"

endchoice

endmenu # CONFIG_X1520_SENSOR_GC2145