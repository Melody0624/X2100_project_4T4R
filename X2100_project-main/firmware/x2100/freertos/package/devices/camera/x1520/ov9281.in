menuconfig CONFIG_X1520_SENSOR_OV9281
    bool "sensor ov9281 (dvp,mipi)"
    select CONFIG_I2C
    select CONFIG_X1520_VIC
    depends on CONFIG_SOC_X1520

config CONFIG_X1520_OV9281_GPIO_RESET
    string "gpio reset(sensor 复位脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1520_OV9281_GPIO_PWDN
    string "gpio pwdn(sensor 电源控制引脚)"
    choice from SOC_GPIO_PINS
    default -1

config CONFIG_X1520_OV9281_I2C_BUSNUM
    int "i2c bus num (sensor 挂接的i2c总线号)"
    default -1


choice "    选择接口类型"
    default CONFIG_X1520_SENSOR_OV9281_DVP

config CONFIG_X1520_SENSOR_OV9281_DVP
    bool "DVP,raw10"

config CONFIG_X1520_SENSOR_OV9281_MIPI
    bool "MIPI, raw10"

endchoice

endmenu # CONFIG_X1520_SENSOR_OV9281
