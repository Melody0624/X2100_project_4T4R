menuconfig CONFIG_CODEC_ES8389
    bool "codec es8389"
    select CONFIG_I2C

config CONFIG_ES8389_I2C_BUSNUM
    int "i2c bus num (codec 挂接的i2c总线号)"
    default -1

config CONFIG_ES8389_PLAYBACK_MAX_GAIN
    int "playback max gain (codec 播放最大音量增益)"
    default 0xFF
    help
        "播放音量增益范围：0x00~0xFF 值越大增益越大"

config CONFIG_ES8389_PLAYBACK_MIN_GAIN
    int "playback min gain (codec 播放最小音量增益)"
    default 0x00
    help
        "播放音量增益范围：0x00~0xFF 值越大增益越大"

config CONFIG_ES8389_CAPTURE_MAX_GAIN
    int "capture max gain (codec 录音最大音量增益)"
    default 0xFF
    help
        "录音音量增益范围：0x00~0xFF 值越大增益越大"

config CONFIG_ES8389_CAPTURE_MIN_GAIN
    int "capture min gain (codec 录音最小音量增益)"
    default 0x00
    help
        "录音音量增益范围：0x00~0xFF 值越大增益越大"

endmenu