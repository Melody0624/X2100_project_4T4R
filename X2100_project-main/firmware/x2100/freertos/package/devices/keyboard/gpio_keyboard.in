menuconfig CONFIG_GPIO_KEYBOARD
    bool "独立按键驱动"
    select CONFIG_INPUT

config CONFIG_GPIO_KEYBOARD_DEV_NAME
    string "独立按键设备名称"
    default "gpio_keyboard"

config CONFIG_GPIO_KEYBOARD_MAX_EVENT_COUNT
    int "独立按键事件缓冲区大小"
    default 64

config CONFIG_GPIO_KEYBOARD_DELAY_TIME_MS
    string "按键消抖时间(ms)"
    default 20

config CONFIG_ADD_GPIO_KEYBOARD1
    bool "添加按键1"
    default n

config CONFIG_GPIO_KEYBOARD1
    string "按键"
    default -1
    choice from SOC_GPIO_PINS
    depends on CONFIG_ADD_GPIO_KEYBOARD1

config CONFIG_GPIO_KEYBOARD1_ACTIVE_LEVEL
    string "按键按下电平"
    default 0
    choice from KEYBOARD_LEVEL
    depends on CONFIG_ADD_GPIO_KEYBOARD1

config CONFIG_GPIO_KEYBOARD1_CODE
    string "键值"
    default KEY_HOME
    choice from KEYBOARD_VALUE
    depends on CONFIG_ADD_GPIO_KEYBOARD1

