menu "uart 设备列表"

config CONFIG_SOC_X1830_UART0
    bool "uart 0"
    select CONFIG_UART

config CONFIG_SOC_X1830_UART0_RX
    string "    rx gpio"
    default -1
    choice from UART0_RX_PINS
    depends on CONFIG_SOC_X1830_UART0

config CONFIG_SOC_X1830_UART0_TX
    string "    tx gpio"
    default -1
    choice from UART0_TX_PINS
    depends on CONFIG_SOC_X1830_UART0

config CONFIG_SOC_X1830_UART0_CTS
    string "    cts gpio"
    default -1
    choice from UART0_CTS_PINS
    depends on CONFIG_SOC_X1830_UART0

config CONFIG_SOC_X1830_UART0_RTS
    string "    rts gpio"
    default -1
    choice from UART0_RTS_PINS
    depends on CONFIG_SOC_X1830_UART0

config CONFIG_SOC_X1830_UART1
    bool "uart 1"
    select CONFIG_UART

config CONFIG_SOC_X1830_UART1_RX
    string "    rx gpio"
    default -1
    choice from UART1_RX_PINS
    depends on CONFIG_SOC_X1830_UART1

config CONFIG_SOC_X1830_UART1_TX
    string "    tx gpio"
    default -1
    choice from UART1_TX_PINS
    depends on CONFIG_SOC_X1830_UART1

config CONFIG_SOC_X1830_UART1_CTS
    string "    cts gpio"
    default -1
    choice from UART1_CTS_PINS
    depends on CONFIG_SOC_X1830_UART1

config CONFIG_SOC_X1830_UART1_RTS
    string "    rts gpio"
    default -1
    choice from UART1_RTS_PINS
    depends on CONFIG_SOC_X1830_UART1

endmenu

array UART0_RX_PINS
    string "uart0 rx 引脚"
    item "GPIO_PB(19) func0" GPIO_PB(19),GPIO_FUNC_0
    item "GPIO_NULL  " -1

array UART0_TX_PINS
    string "uart0 tx 引脚"
    item "GPIO_PB(22) func0" GPIO_PB(22),GPIO_FUNC_0
    item "GPIO_NULL  " -1

array UART0_CTS_PINS
    string "uart0 cts 引脚"
    item "GPIO_NULL  " -1
    item "GPIO_PB(20) func0" GPIO_PB(20),GPIO_FUNC_0

array UART0_RTS_PINS
    string "uart0 rts 引脚"
    item "GPIO_NULL  " -1
    item "GPIO_PB(21) func0" GPIO_PB(21),GPIO_FUNC_0

array UART1_RX_PINS
    string "uart1 rx 引脚"
    item "GPIO_PB(24) func0" GPIO_PB(24),GPIO_FUNC_0
    item "GPIO_NULL  " -1

array UART1_TX_PINS
    string "uart1 tx 引脚"
    item "GPIO_PB(23) func0" GPIO_PB(23),GPIO_FUNC_0
    item "GPIO_NULL  " -1

array UART1_CTS_PINS
    string "uart1 cts 引脚"
    item "GPIO_NULL  " -1

array UART1_RTS_PINS
    string "uart1 rts 引脚"
    item "GPIO_NULL  " -1

array SOC_UART_DEVICES
    int "soc uart 设备"
    item "uart 0" 0
    item "uart 1" 1

array SOC_UART_BAUD_RATES
    int "soc uart 波特率"
    item      "50" 50
    item      "75" 75
    item     "110" 110
    item     "134" 134
    item     "150" 150
    item     "200" 200
    item     "300" 300
    item     "600" 600
    item    "1200" 1200
    item    "1800" 1800
    item    "2400" 2400
    item    "4800" 4800
    item    "9600" 9600
    item   "19200" 19200
    item   "38400" 38400
    item   "57600" 57600
    item  "115200" 115200
    item  "230400" 230400
    item  "460800" 460800
    item  "500000" 500000
    item  "576000" 576000
    item  "921600" 921600
    item "1000000" 1000000
    item "1152000" 1152000
    item "1500000" 1500000
    item "2000000" 2000000
    item "2500000" 2500000
