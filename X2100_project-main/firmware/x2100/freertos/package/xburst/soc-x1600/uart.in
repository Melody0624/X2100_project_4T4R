menu "uart 设备列表"

config CONFIG_SOC_X1600_UART0
    bool "uart 0"
    depends on CONFIG_XBURST_X1600
    select CONFIG_UART
    select CONFIG_DMA

config CONFIG_SOC_X1600_UART0_RX
    string "    rx gpio"
    default -1
    choice from UART0_RX_PINS
    depends on CONFIG_SOC_X1600_UART0

config CONFIG_SOC_X1600_UART0_TX
    string "    tx gpio"
    default -1
    choice from UART0_TX_PINS
    depends on CONFIG_SOC_X1600_UART0

config CONFIG_SOC_X1600_UART0_CTS
    string "    cts gpio"
    default -1
    choice from UART0_CTS_PINS
    depends on CONFIG_SOC_X1600_UART0

config CONFIG_SOC_X1600_UART0_RTS
    string "    rts gpio"
    default -1
    choice from UART0_RTS_PINS
    depends on CONFIG_SOC_X1600_UART0

config CONFIG_SOC_X1600_UART0_SW_CTS
    string "    sw cts gpio"
    default -1
    choice from SOC_GPIO_PINS
    depends on CONFIG_SOC_X1600_UART0

config CONFIG_SOC_X1600_UART0_SW_RTS
    string "    sw rts gpio"
    default -1
    choice from SOC_GPIO_PINS
    depends on CONFIG_SOC_X1600_UART0

config CONFIG_SOC_X1600_UART1
    bool "uart 1"
