menuconfig CONFIG_SOC_X1600_UART
    bool
    depends on CONFIG_XBURST_X1600

array UART0_RX_PINS
    string "uart0 rx 引脚"
    item "GPIO_PB(7) func0" GPIO_PB(7),GPIO_FUNC_0
    item "GPIO_NULL  " -1

array UART0_TX_PINS
    string "uart0 tx 引脚"
    item "GPIO_PB(8) func0" GPIO_PB(8),GPIO_FUNC_0
    item "GPIO_NULL  " -1

array UART0_CTS_PINS
    string "uart0 cts 引脚"
    item "GPIO_NULL  " -1
    item "GPIO_PB(9) func0" GPIO_PB(9),GPIO_FUNC_0

array UART0_RTS_PINS
    string "uart0 rts 引脚"
    item "GPIO_NULL  " -1
    item "GPIO_PB(10) func0" GPIO_PB(10),GPIO_FUNC_0

array UART1_RX_PINS
    string "uart1 rx 引脚"
    item "GPIO_PB(3) func1" GPIO_PB(3),GPIO_FUNC_1
    item "GPIO_NULL  " -1

array UART1_TX_PINS
    string "uart1 tx 引脚"
    item "GPIO_PB(2) func1" GPIO_PB(2),GPIO_FUNC_1
    item "GPIO_NULL  " -1

array UART1_CTS_PINS
    string "uart1 cts 引脚"
    item "GPIO_NULL  " -1
    item "GPIO_PB(5) func1" GPIO_PB(5),GPIO_FUNC_1

array UART1_RTS_PINS
    string "uart1 rts 引脚"
    item "GPIO_NULL  " -1
    item "GPIO_PB(4) func1" GPIO_PB(4),GPIO_FUNC_1

array UART2_RX_PINS
    string "uart2 rx 引脚"
    item "GPIO_PA(31) func2" GPIO_PA(31),GPIO_FUNC_2
    item "GPIO_PB(1) func1" GPIO_PB(1),GPIO_FUNC_1
    item "GPIO_NULL  " -1

array UART2_TX_PINS
    string "uart2 tx 引脚"
    item "GPIO_PA(30) func2" GPIO_PA(30),GPIO_FUNC_2
    item "GPIO_PB(0) func1" GPIO_PB(0),GPIO_FUNC_1
    item "GPIO_NULL  " -1

array UART2_CTS_PINS
    string "uart2 cts 引脚"
    item "GPIO_NULL  " -1

array UART2_RTS_PINS
    string "uart2 rts 引脚"
    item "GPIO_NULL  " -1

array UART3_RX_PINS
    string "uart3 rx 引脚"
    item "GPIO_PB(5) func0" GPIO_PB(5),GPIO_FUNC_0
    item "GPIO_PD(5) func2" GPIO_PD(5),GPIO_FUNC_2
    item "GPIO_NULL  " -1

array UART3_TX_PINS
    string "uart3 tx 引脚"
    item "GPIO_PB(4) func0" GPIO_PB(4),GPIO_FUNC_0
    item "GPIO_PD(4) func2" GPIO_PD(4),GPIO_FUNC_2
    item "GPIO_NULL  " -1

array UART3_CTS_PINS
    string "uart3 cts 引脚"
    item "GPIO_NULL  " -1

array UART3_RTS_PINS
    string "uart3 rts 引脚"
    item "GPIO_NULL  " -1
endmenu

