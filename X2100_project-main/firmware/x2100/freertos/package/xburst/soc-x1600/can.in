menu "can 设备列表"

config CONFIG_SOC_X1600_CAN0
    bool "can 0"
    select CONFIG_CAN
    select CONFIG_DMA

config CONFIG_SOC_X1600_CAN0_RX
    string "    rx gpio"
    default -1
    choice from CAN0_RX_PINS
    depends on CONFIG_SOC_X1600_CAN0

config CONFIG_SOC_X1600_CAN0_TX
    string "    tx gpio"
    default -1
    choice from CAN0_TX_PINS
    depends on CONFIG_SOC_X1600_CAN0


config CONFIG_SOC_X1600_CAN1
    bool "can 1"
    select CONFIG_CAN
    select CONFIG_DMA

config CONFIG_SOC_X1600_CAN1_RX
    string "    rx gpio"
    default -1
    choice from CAN1_RX_PINS
    depends on CONFIG_SOC_X1600_CAN1

config CONFIG_SOC_X1600_CAN1_TX
    string "    tx gpio"
    default -1
    choice from CAN1_TX_PINS
    depends on CONFIG_SOC_X1600_CAN1

endmenu


array CAN0_RX_PINS
    string "can0 rx 引脚"
    item "GPIO_PD(3) func1" GPIO_PD(3),GPIO_FUNC_1
    item "GPIO_NULL  " -1

array CAN0_TX_PINS
    string "can0 tx 引脚"
    item "GPIO_PD(2) func1" GPIO_PD(2),GPIO_FUNC_1
    item "GPIO_NULL  " -1


array CAN1_RX_PINS
    string "can1 rx 引脚"
    item "GPIO_PD(5) func1" GPIO_PD(5),GPIO_FUNC_1
    item "GPIO_NULL  " -1

array CAN1_TX_PINS
    string "can1 tx 引脚"
    item "GPIO_PD(4) func1" GPIO_PD(4),GPIO_FUNC_1
    item "GPIO_NULL  " -1
