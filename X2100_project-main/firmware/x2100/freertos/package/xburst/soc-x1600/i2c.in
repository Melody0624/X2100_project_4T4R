menu "I2C 总线"
    help
        "依赖于 I2C 驱动"

config CONFIG_X1600_I2C0_BUS
    bool "选择 I2C0"
    select CONFIG_I2C

choice "              选择I2C0 GPIO"
    default CONFIG_X1600_I2C0_PA
    depends on CONFIG_X1600_I2C0_BUS

config CONFIG_X1600_I2C0_PA
    bool "SDA: GPIO_PA(29)、SCL: GPIO_PA(28)"

config CONFIG_X1600_I2C0_PB
    bool "SDA: GPIO_PB(31)、SCL: GPIO_PB(30)"
    depends on CONFIG_XBURST_X1600

endchoice

config CONFIG_X1600_I2C0_RATE
    int "       I2C0 速率"
    default 400000
    depends on CONFIG_X1600_I2C0_BUS

config CONFIG_X1600_I2C1_BUS
    bool "选择 I2C1"
    select CONFIG_I2C

choice "              选择I2C1 GPIO"
    default CONFIG_X1600_I2C1_PB_15_16
    depends on CONFIG_X1600_I2C1_BUS

config CONFIG_X1600_I2C1_PB_15_16
    bool "SDA: GPIO_PB(16)、SCL: GPIO_PB(15)"

config CONFIG_X1600_I2C1_PB_19_20
    bool "SDA: GPIO_PB(20)、SCL: GPIO_PB(19)"
    depends on CONFIG_XBURST_X1600

endchoice

config CONFIG_X1600_I2C1_RATE
    int "       I2C1 速率"
    default 400000
    depends on CONFIG_X1600_I2C1_BUS

endmenu # I2C 总线

