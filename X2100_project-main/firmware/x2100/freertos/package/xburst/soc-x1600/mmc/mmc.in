menu "MMC 总线"

config CONFIG_SOC_X1600_MSC0_BUS
    bool "选择 MMC0"
    select CONFIG_MMC

choice "          选择MMC0 GPIO"
    default CONFIG_SOC_X1600_MSC0_PC_4BIT
    depends on CONFIG_SOC_X1600_MSC0_BUS

config CONFIG_SOC_X1600_MSC0_PC_4BIT
    bool "    MMC0 Bus 4bit (PC17 ~ PC22)"

config CONFIG_SOC_X1600_MSC0_PB_4BIT
    bool "    MMC0 Bus 4bit (PB12 ~ PB17)"

endchoice

config CONFIG_SOC_X1600_MSC0_MAX_FREQ
    int "  MMC0最大速度"
    default 48000000
    depends on CONFIG_SOC_X1600_MSC0_BUS
    help
        "支持范围是 0 ~ 50M "


config CONFIG_SOC_X1600_MSC1_BUS
    bool "选择 MMC1"
    select CONFIG_MMC

choice "          选择MMC1 GPIO"
    default CONFIG_SOC_X1600_MSC1_PD_4BIT
    depends on CONFIG_SOC_X1600_MSC1_BUS

config CONFIG_SOC_X1600_MSC1_PD_4BIT
    bool "    MMC1/SDIO Bus 4bit (PD00 ~ PD05)"

endchoice

config CONFIG_SOC_X1600_MSC1_MAX_FREQ
    int "  MMC1/SDIO最大速度"
    default 48000000
    depends on CONFIG_SOC_X1600_MSC1_BUS
    help
        "支持范围是 0 ~ 50M "

endmenu
