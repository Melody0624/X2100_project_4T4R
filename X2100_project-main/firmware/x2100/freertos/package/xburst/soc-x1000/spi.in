array SOC_X1000_SPI0_MISO_IO
    string "SPI MISO(DR) 引脚"
    item "GPIO_NULL  " -1
    item "GPIO_PA(23) func0" GPIO_PA(23),GPIO_FUNC_2
    item "GPIO_PA(28) func0" GPIO_PA(28),GPIO_FUNC_2
    item "GPIO_PD(3) func2" GPIO_PD(3),GPIO_FUNC_0

array SOC_X1000_SPI0_MOSI_IO
    string "SPI MOSI(DT) 引脚"
    item "GPIO_NULL  " -1
    item "GPIO_PA(22) func0" GPIO_PA(22),GPIO_FUNC_2
    item "GPIO_PA(29) func0" GPIO_PA(29),GPIO_FUNC_2
    item "GPIO_PD(2) func2" GPIO_PD(2),GPIO_FUNC_0

array SOC_X1000_SPI0_CLK_IO
    string "SPI CLK 引脚"
    item "GPIO_NULL  " -1
    item "GPIO_PA(24) func0" GPIO_PA(24),GPIO_FUNC_2
    item "GPIO_PA(26) func0" GPIO_PA(26),GPIO_FUNC_2
    item "GPIO_PD(0) func2" GPIO_PD(0),GPIO_FUNC_0

menu "SPI 总线"
    help
        "依赖于 SPI 驱动"

config CONFIG_X1000_SPI0
    bool "选择 SPI0"
    select CONFIG_SPI
    select CONFIG_DMA

config CONFIG_X1000_SPI0_MISO
    string "        MISO"
    default -1
    choice from SOC_X1000_SPI0_MISO_IO
    depends on CONFIG_X1000_SPI0
    help
        "MISO= -1,表示不使用MISO引脚"

config CONFIG_X1000_SPI0_MOSI
    string "        MOSI"
    default -1
    choice from SOC_X1000_SPI0_MOSI_IO
    depends on CONFIG_X1000_SPI0
    help
        "MOSI= -1,表示不使用MOSI引脚"

config CONFIG_X1000_SPI0_CLK
    string "        CLK"
    default -1
    choice from SOC_X1000_SPI0_CLK_IO
    depends on CONFIG_X1000_SPI0

endmenu # SPI 总线