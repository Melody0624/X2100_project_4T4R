menuconfig CONFIG_X1000_UTILS
    bool "utils 驱动(芯片的一些小功能)"

config CONFIG_X1000_UTILS_RTC32K
    bool "rtc32k 时钟bypass输出(PB26)"
    default y

config CONFIG_X1000_UTILS_RTC32K_INIT_ON
    bool "        rtc32k 时钟初始化即使能rtc32k输出"
    depends on CONFIG_X1000_UTILS_RTC32K


config CONFIG_X1000_UTILS_CLK24M
    bool "clk24M 时钟bypass输出(PB27)"
    default n

config CONFIG_X1000_UTILS_CLK24M_INIT_ON
    bool "        clk24M 时钟初始化即使能clk24M 输出"
    depends on CONFIG_X1000_UTILS_CLK24M

endmenu
