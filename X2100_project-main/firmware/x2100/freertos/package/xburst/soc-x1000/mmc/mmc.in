menu "MMC 总线"

config CONFIG_SOC_X1000_MSC0_BUS
    bool "选择 MMC0"
    select CONFIG_MMC

choice "          选择MMC0 GPIO"
    default CONFIG_SOC_X1000_MSC0_PA_8BIT
    depends on CONFIG_SOC_X1000_MSC0_BUS

config CONFIG_SOC_X1000_MSC0_PA_8BIT
    bool "    MMC0 Bus 8bit (PA16 ~ PA24)"

config CONFIG_SOC_X1000_MSC0_PA_4BIT
    bool "    MMC0 Bus 4bit (PA20 ~ PA24)"

endchoice

config CONFIG_SOC_X1000_MSC0_MAX_FREQ
    int "  MMC0最大速度"
    default 50000000
    depends on CONFIG_SOC_X1000_MSC0_BUS
    help
        "支持范围是 0 ~ 50M "



config CONFIG_SOC_X1000_MSC1_BUS
    bool "选择 MMC1"
    select CONFIG_MMC

choice "          选择MMC1 GPIO"
    default CONFIG_SOC_X1000_MSC1_PC_4BIT
    depends on CONFIG_SOC_X1000_MSC1_BUS

config CONFIG_SOC_X1000_MSC1_PC_4BIT
    bool "    MMC1 Bus 4bit (PC00 ~ PC05)"

endchoice

config CONFIG_SOC_X1000_MSC1_MAX_FREQ
    int "  MMC1最大速度"
    default 50000000
    depends on CONFIG_SOC_X1000_MSC1_BUS
    help
        "支持范围是 0 ~ 50M "

endmenu

