menuconfig CONFIG_X1021_LCD
    bool "LCD 驱动"
    select CONFIG_FB

choice "选择SLCD的GPIO接口"
    default CONFIG_X1021_SLCD_GPIOB

config CONFIG_X1021_SLCD_GPIOB
    bool "SLCD接口(GPIO_PB)"

config CONFIG_X1021_SLCD_GPIOC
    bool "SLCD接口(GPIO_PC)"

endchoice

config CONFIG_X1021_LCD_FB0_ENABLE
    bool "使能fb0"

config CONFIG_X1021_LCD_FB0_FRM_CNT
    int "fb0帧缓冲数量"
    default 2
    depends on CONFIG_X1021_LCD_FB0_ENABLE

config CONFIG_X1021_LCD_FB0_NAME
    string "设备节点名字"
    default "fb0"
    depends on CONFIG_X1021_LCD_FB0_ENABLE
endmenu