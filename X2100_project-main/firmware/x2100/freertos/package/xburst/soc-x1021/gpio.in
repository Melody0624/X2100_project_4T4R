menu "GPIO 电源"
    help
        "配置GPIO电源"

choice "选择VDDIO_0 (PA00~PA22) "
    default CONFIG_X1021_VDDIO_0_1V8

config CONFIG_X1021_VDDIO_0_1V8
    bool "VDDIO_0 = 1.8V"

config CONFIG_X1021_VDDIO_0_3V3
    bool "VDDIO_0 = 3.3V"

endchoice

choice "选择VDDIO_1 (PA23~31/PB/PC00~01) "
    default CONFIG_X1021_VDDIO_1_3V3

config CONFIG_X1021_VDDIO_1_1V8
    bool "VDDIO_1 = 1.8V"

config CONFIG_X1021_VDDIO_1_3V3
    bool "VDDIO_1 = 3.3V (数据手册只推荐VDDIO_1 = 3.3V)"

endchoice

choice "选择VDDIO_2 (PC02~PC18) "
    default CONFIG_X1021_VDDIO_2_3V3

config CONFIG_X1021_VDDIO_2_1V8
    bool "VDDIO_2 = 1.8V"

config CONFIG_X1021_VDDIO_2_3V3
    bool "VDDIO_2 = 3.3V"

endchoice

endmenu
